## YandexGPT (Phase 1 LLM)
# Service account key JSON (console -> IAM -> Service accounts -> Create key)
# Tip: wrap JSON in single quotes in `.env.local`.
YANDEX_SERVICE_ACCOUNT_KEY_JSON='{"id":"...","service_account_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'

# Used to build model URI when YANDEX_GPT_MODEL_URI is not set
YANDEX_FOLDER_ID=your_folder_id

# Optional overrides
# YANDEX_GPT_ENDPOINT=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
# YANDEX_GPT_MODEL_URI=gpt://<folder_id>/yandexgpt-lite/latest
# YANDEX_GPT_MODEL=yandexgpt-lite
# YANDEX_GPT_VERSION=latest

## Yandex Object Storage (Phase 2)
YANDEX_ACCESS_KEY_ID=your_key_here
YANDEX_SECRET_ACCESS_KEY=your_secret_here
YANDEX_BUCKET_NAME=uhp-vvs-dev
# YANDEX_S3_ENDPOINT=https://storage.yandexcloud.net
# YANDEX_REGION=ru-central1

## DataSphere (Phase 3)
DATASPHERE_FOLDER_ID=your_folder_id
# YANDEX_SERVICE_ACCOUNT_KEY_JSON='{"id":"...","service_account_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}'
# DATASPHERE_JOB_ID=your_job_id
# MOCK_DATASPHERE=true

## Real-time providers (Phase 1)
SIMLI_API_KEY=your_key_here
DEEPGRAM_API_KEY=your_key_here
# DEEPGRAM_STT_MODEL=nova-2
# DEEPGRAM_TTS_MODEL=aura-asteria-en
# DEEPGRAM_TTS_ENCODING=mp3
